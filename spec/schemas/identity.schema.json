{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prashantbhardwaj30/kya-rails/blob/main/spec/schemas/identity.schema.json",
  "title": "KYA identity: who the agent is",
  "description": "Maps to MAS KYA information item (a) 'who the agent is'. Field names are this project's interpretation; MAS has not published a field list.",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_id", "agent_name", "agent_version", "developer", "operator", "public_key"],
  "properties": {
    "agent_id": { "$ref": "common.schema.json#/$defs/agentId" },
    "agent_name": { "type": "string", "minLength": 3, "maxLength": 80 },
    "agent_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "developer": { "$ref": "#/$defs/legalEntity" },
    "operator": { "$ref": "#/$defs/legalEntity" },
    "public_key": {
      "type": "object",
      "description": "The agent's own signing key as a JWK (RFC 8037 OKP / Ed25519). Actions must be signed with it.",
      "additionalProperties": false,
      "required": ["kty", "crv", "x", "kid"],
      "properties": {
        "kty": { "const": "OKP" },
        "crv": { "const": "Ed25519" },
        "x": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "kid": { "type": "string", "minLength": 3, "maxLength": 120 }
      }
    },
    "hosting_region": { "type": "string", "enum": ["IN", "SG", "OTHER"], "description": "Where the agent runtime executes. Useful for data-localisation review." }
  },
  "$defs": {
    "legalEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legal_name", "registration"],
      "properties": {
        "legal_name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "registration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scheme", "value"],
          "properties": {
            "scheme": { "enum": ["CIN", "LLPIN", "GSTIN", "LEI", "UEN"] },
            "value": { "type": "string", "minLength": 5, "maxLength": 25 }
          },
          "allOf": [
            { "if": { "properties": { "scheme": { "const": "CIN" } } }, "then": { "properties": { "value": { "pattern": "^[LU][0-9]{5}[A-Z]{2}[0-9]{4}[A-Z]{3}[0-9]{6}$" } } } },
            { "if": { "properties": { "scheme": { "const": "GSTIN" } } }, "then": { "properties": { "value": { "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$" } } } },
            { "if": { "properties": { "scheme": { "const": "LEI" } } }, "then": { "properties": { "value": { "pattern": "^[A-Z0-9]{18}[0-9]{2}$" } } } }
          ]
        }
      }
    }
  }
}
