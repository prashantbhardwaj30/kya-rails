{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prashantbhardwaj30/kya-rails/blob/main/spec/schemas/mandate.schema.json",
  "title": "KYA mandate: the limits and conditions the agent operates under",
  "description": "Maps to MAS KYA item (c) 'what mandate it operates under' and SAFR's description of a mandate (what the agent may do, within what limits, under what conditions). The consent block models DPDP Act s.6 purpose limitation. Our interpretation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mandate_id", "purpose", "purpose_text", "valid_from", "valid_until", "limits", "allowed_merchant_categories", "allowed_payees", "consent"],
  "properties": {
    "mandate_id": { "type": "string", "pattern": "^mdt_[a-z0-9]{6,32}$" },
    "purpose": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/purpose" } },
    "purpose_text": { "type": "string", "minLength": 10, "maxLength": 300 },
    "valid_from": { "$ref": "common.schema.json#/$defs/datetime" },
    "valid_until": { "$ref": "common.schema.json#/$defs/datetime" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "per_txn_max_paise", "aggregate_max_paise", "max_txn_per_day", "human_approval_above_paise"],
      "properties": {
        "currency": { "const": "INR" },
        "per_txn_max_paise": { "$ref": "common.schema.json#/$defs/paise" },
        "aggregate_max_paise": { "$ref": "common.schema.json#/$defs/paise" },
        "max_txn_per_day": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "human_approval_above_paise": { "$ref": "common.schema.json#/$defs/paise" }
      }
    },
    "allowed_merchant_categories": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/mcc" } },
    "allowed_payees": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/payee" }, "description": "Empty array means any payee within the allowed merchant categories." },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consent_id", "purposes", "data_categories", "given_at", "expires_at", "withdrawn"],
      "properties": {
        "consent_id": { "type": "string", "pattern": "^cns_[a-z0-9]{6,32}$" },
        "purposes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/purpose" } },
        "data_categories": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/dataCategory" } },
        "consent_manager": { "type": ["string", "null"], "maxLength": 120 },
        "given_at": { "$ref": "common.schema.json#/$defs/datetime" },
        "expires_at": { "$ref": "common.schema.json#/$defs/datetime" },
        "withdrawn": { "type": "boolean" }
      }
    }
  }
}
